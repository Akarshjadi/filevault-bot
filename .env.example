# FileVault Bot — Environment Variables
# Copy this to .env and fill in your values

# Telegram Bot Token (REQUIRED)
# Get from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Database URL (REQUIRED)
# PostgreSQL connection string for Supabase or any PostgreSQL instance
# Format: postgresql+asyncpg://user:password@host:port/database
#
# For Supabase:
#   - Session pooler (port 5432): postgresql+asyncpg://postgres.<project_ref>:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#   - Transaction pooler (port 6543): postgresql+asyncpg://postgres.<project_ref>:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#     (pooled requires username in format: postgres.<project_ref>)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/filevault

# Storage path for local file backups (optional)
# Set to empty string to disable local backups
STORAGE_BASE=./vault_storage

# Staging channel for file preservation (optional)
# Create a private channel, add bot as admin, and put channel ID here
# This preserves files even if user deletes original message
STAGING_CHANNEL_ID=0

# Cloudflare R2 Storage (DPDP-compliant dual-bucket setup)
S3_ENDPOINT_URL=https://<your-account>.r2.cloudflarestorage.com
R2_MAIN_BUCKET=filevault-approved
R2_MINORS_BUCKET=filevault-minors-encrypted
S3_ACCESS_KEY_ID=<your-access-key-id>
S3_SECRET_ACCESS_KEY=<your-secret-key>

# Encryption Master Salt (generate with: python -c "import secrets; print(secrets.token_hex(32))")
ENCRYPTION_MASTER_SALT=<your-64-char-hex-salt>

# Staging channel for file preservation (optional)
STAGING_CHANNEL_ID=0

# Logging level (optional, default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
