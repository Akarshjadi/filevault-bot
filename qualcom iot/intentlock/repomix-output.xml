# IntentLock environment configuration.
# Copy to `.env` and adjust. Nothing here is a secret by default; the file exists
# so that deployment-specific paths are never hard-coded in source.

# Root directory containing raw datasets (InGesture, Speech Commands, UCI HAR, ...).
INTENTLOCK_DATA_ROOT=./data

# Directory holding exported/inference-ready models.
INTENTLOCK_MODEL_DIR=./models

# Directory for structured telemetry JSONL output.
INTENTLOCK_TELEMETRY_DIR=./artifacts/telemetry

# Path to the runtime configuration YAML.
INTENTLOCK_CONFIG=./configs/intentlock.yaml

# --- Hardware backends (only read by deployment/hardware backends) ---
# UNO Q bridge: MCU sketch exposes IMU reads; the Linux side polls via Bridge.call.
INTENTLOCK_IMU_BACKEND=simulator   # simulator | arduino_bridge | csv_replay
INTENTLOCK_AUDIO_BACKEND=simulator # simulator | sounddevice
INTENTLOCK_VISION_BACKEND=simulator # simulator | opencv

# Serial port / bridge function name for the Arduino Bridge backend.
INTENTLOCK_BRIDGE_HOST=arduino.local
INTENTLOCK_BRIDGE_IMU_FN=read_imu_sample

# Camera / microphone indices on the edge device.
INTENTLOCK_CAMERA_INDEX=0
INTENTLOCK_MIC_INDEX=0

# Deterministic seed used across preprocessing, training and simulation.
INTENTLOCK_SEED=1337
